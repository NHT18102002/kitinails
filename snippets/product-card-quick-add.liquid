{% comment %}
  Renders the standard product-card quick-add control.

  Required arguments:
  - product
  - product_form_id
  - section_id
  - owner_section_id
  - container_classes
  - submit_classes
  - requires_pdp_selection
  - horizontal
  - homepage_context
  - listing_context
  - homepage_quick_buy_visual
  - homepage_sold_out_visual
  - listing_quick_buy_visual
{% endcomment %}

<div class="{{ container_classes }}">
  {%- liquid
    assign qty_rules = false
    if product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null or product.selected_or_first_available_variant.quantity_rule.increment > 1
      assign qty_rules = true
    endif
  -%}
  {%- if requires_pdp_selection -%}
    <a
      href="{{ product.url }}"
      class="{{ submit_classes }}{% if horizontal %} card--horizontal__quick-add animate-arrow{% endif %}"
      aria-label="{{ 'products.product.choose_options' | t }} {{ product.title | escape }}"
    >
      {%- if homepage_context -%}
        <span class="visually-hidden">{{ 'products.product.choose_options' | t }}</span>
        {{ homepage_quick_buy_visual }}
      {%- elsif listing_context and horizontal != true -%}
        {{ listing_quick_buy_visual }}
      {%- else -%}
        {%- if horizontal -%}
          QUICK BUY
        {%- else -%}
          {{ 'products.product.choose_options' | t }}
        {%- endif -%}
        {%- if horizontal -%}
          <span class="icon-wrap">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
      {%- endif -%}
    </a>
  {%- elsif product.variants_count > 1 or qty_rules -%}
    <modal-opener data-modal="#QuickAdd-{{ product.id }}">
      <button
        id="{{ product_form_id }}-submit"
        type="submit"
        name="add"
        class="{{ submit_classes }}{% if horizontal %} card--horizontal__quick-add animate-arrow{% endif %}"
        aria-haspopup="dialog"
        aria-label="{{ 'products.product.choose_options' | t }} {{ product.title | escape }}"
        aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}"
        data-product-url="{{ product.url }}"
      >
        {%- if homepage_context -%}
          <span class="visually-hidden">{{ 'products.product.choose_options' | t }}</span>
          {{ homepage_quick_buy_visual }}
        {%- elsif listing_context and horizontal != true -%}
          {{ listing_quick_buy_visual }}
        {%- else -%}
          {%- if horizontal -%}
            QUICK BUY
          {%- else -%}
            {{ 'products.product.choose_options' | t }}
          {%- endif -%}
          {%- if horizontal -%}
            <span class="icon-wrap">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}
        {%- endif -%}
        {%- render 'loading-spinner' -%}
      </button>
    </modal-opener>
    <quick-add-modal id="QuickAdd-{{ product.id }}" class="quick-add-modal">
      <div
        role="dialog"
        aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
        aria-modal="true"
        class="quick-add-modal__content global-settings-popup"
        tabindex="-1"
      >
        <button
          id="ModalClose-{{ product.id }}"
          type="button"
          class="quick-add-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
        <div id="QuickAddInfo-{{ product.id }}" class="quick-add-modal__content-info"></div>
      </div>
    </quick-add-modal>
  {%- else -%}
    <product-form data-section-id="{{ owner_section_id }}">
      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="product-variant-id"
          {% if product.selected_or_first_available_variant.available == false %}
            disabled
          {% endif %}
        >
        <button
          id="{{ product_form_id }}-submit"
          type="submit"
          name="add"
          class="{{ submit_classes }}{% if horizontal %} card--horizontal__quick-add{% endif %}"
          aria-haspopup="dialog"
          aria-label="{%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.add_to_cart' | t }} {{ product.title | escape }}{%- else -%}{{ 'products.product.sold_out' | t }} {{ product.title | escape }}{%- endif -%}"
          aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product.id }}"
          aria-live="polite"
          data-sold-out-message="true"
          {% if product.selected_or_first_available_variant.available == false %}
            disabled
          {% endif %}
        >
          {%- if homepage_context -%}
            <span class="visually-hidden">
              {%- if product.selected_or_first_available_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ homepage_quick_buy_visual }}
            {%- else -%}
              {{ homepage_sold_out_visual }}
            {%- endif -%}
          {%- elsif listing_context and horizontal != true -%}
            {{ listing_quick_buy_visual }}
          {%- else -%}
            <span>
              {%- if product.selected_or_first_available_variant.available -%}
                {%- if horizontal -%}
                  QUICK BUY
                {%- else -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- endif -%}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            {%- if horizontal -%}
              <span class="icon-wrap">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            {%- endif -%}
          {%- endif -%}
          <span class="sold-out-message hidden">
            {{ 'products.product.sold_out' | t }}
          </span>
          {%- render 'loading-spinner' -%}
        </button>
      {%- endform -%}
    </product-form>
  {%- endif -%}
</div>
