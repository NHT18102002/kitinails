{
  "name": "ersanails",
  "version": "1.0.0",
  "description": "Authorized Ersa Nails Shopify Online Store 2.0 theme rebuild and theme-quality tooling.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:theme:unit",
    "test:theme:unit": "node --test tests/*.test.cjs tests/theme/*.test.cjs",
    "test:theme:e2e": "playwright test",
    "test:theme:e2e:update": "playwright test --update-snapshots=all",
    "check:theme": "shopify theme check --no-color",
    "check:theme:all": "npm run check:theme && npm run test:theme:unit",
    "report:theme:assets": "node scripts/theme-asset-report.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
