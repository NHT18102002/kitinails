{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/package.json",
      "/package-lock.json",
      "/Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
